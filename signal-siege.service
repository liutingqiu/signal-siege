[Unit]
Description=Signal Siege agent arena
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/signal-siege
ExecStart=/usr/bin/python3 /home/ubuntu/signal-siege/server.py
Environment=SIGNAL_SIEGE_PORT=80
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
